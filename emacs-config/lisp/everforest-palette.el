;;; everforest-palette.el --- Everforest colours -*- lexical-binding: t; -*-

;; The hard dark and hard light palettes, transcribed from
;; everforest#get_palette in sainnhe/everforest, the same colour scheme the
;; Neovim and Vim configs use.  g:everforest_background was 'hard', so these are
;; the hard variants.

;;; Code:

(defconst everforest-palette-dark
  '((bg-dim     . "#1e2326")
    (bg0        . "#272e33")
    (bg1        . "#2e383c")
    (bg2        . "#374145")
    (bg3        . "#414b50")
    (bg4        . "#495156")
    (bg5        . "#4f5b58")
    (bg-visual  . "#4c3743")
    (bg-red     . "#493b40")
    (bg-yellow  . "#45443c")
    (bg-green   . "#3c4841")
    (bg-blue    . "#384b55")
    (bg-purple  . "#463f48")
    (fg         . "#d3c6aa")
    (red        . "#e67e80")
    (orange     . "#e69875")
    (yellow     . "#dbbc7f")
    (green      . "#a7c080")
    (aqua       . "#83c092")
    (blue       . "#7fbbb3")
    (purple     . "#d699b6")
    (grey0      . "#7a8478")
    (grey1      . "#859289")
    (grey2      . "#9da9a0"))
  "Everforest hard dark palette.")

(defconst everforest-palette-light
  '((bg-dim     . "#f2efdf")
    (bg0        . "#fffbef")
    (bg1        . "#f8f5e4")
    (bg2        . "#f2efdf")
    (bg3        . "#edeada")
    (bg4        . "#e8e5d5")
    (bg5        . "#bec5b2")
    (bg-visual  . "#f0f2d4")
    (bg-red     . "#ffe7de")
    (bg-yellow  . "#fef2d5")
    (bg-green   . "#f3f5d9")
    (bg-blue    . "#ecf5ed")
    (bg-purple  . "#fceced")
    (fg         . "#5c6a72")
    (red        . "#f85552")
    (orange     . "#f57d26")
    (yellow     . "#dfa000")
    (green      . "#8da101")
    (aqua       . "#35a77c")
    (blue       . "#3a94c5")
    (purple     . "#df69ba")
    (grey0      . "#a6b0a0")
    (grey1      . "#939f91")
    (grey2      . "#829181"))
  "Everforest hard light palette.")

(defun everforest-face-specs (palette)
  "Return `custom-theme-set-faces' specs for PALETTE."
  (let ((bg-dim    (alist-get 'bg-dim palette))
        (bg0       (alist-get 'bg0 palette))
        (bg1       (alist-get 'bg1 palette))
        (bg2       (alist-get 'bg2 palette))
        (bg3       (alist-get 'bg3 palette))
        (bg4       (alist-get 'bg4 palette))
        (bg5       (alist-get 'bg5 palette))
        (bg-visual (alist-get 'bg-visual palette))
        (bg-red    (alist-get 'bg-red palette))
        (bg-yellow (alist-get 'bg-yellow palette))
        (bg-green  (alist-get 'bg-green palette))
        (bg-blue   (alist-get 'bg-blue palette))
        (fg        (alist-get 'fg palette))
        (red       (alist-get 'red palette))
        (orange    (alist-get 'orange palette))
        (yellow    (alist-get 'yellow palette))
        (green     (alist-get 'green palette))
        (aqua      (alist-get 'aqua palette))
        (blue      (alist-get 'blue palette))
        (purple    (alist-get 'purple palette))
        (grey0     (alist-get 'grey0 palette))
        (grey1     (alist-get 'grey1 palette))
        (grey2     (alist-get 'grey2 palette)))
    `(;; Frame
      (default                     ((t (:background ,bg0 :foreground ,fg))))
      (cursor                      ((t (:background ,fg))))
      (region                      ((t (:background ,bg-visual :extend t))))
      (highlight                   ((t (:background ,bg2))))
      (hl-line                     ((t (:background ,bg1 :extend t))))
      (fringe                      ((t (:background ,bg0 :foreground ,grey0))))
      (vertical-border             ((t (:foreground ,bg4))))
      (window-divider              ((t (:foreground ,bg4))))
      (window-divider-first-pixel  ((t (:foreground ,bg4))))
      (window-divider-last-pixel   ((t (:foreground ,bg4))))
      (line-number                 ((t (:background ,bg0 :foreground ,bg5))))
      (line-number-current-line    ((t (:background ,bg1 :foreground ,fg))))
      (minibuffer-prompt           ((t (:foreground ,green :weight bold))))
      (shadow                      ((t (:foreground ,grey0))))
      (secondary-selection         ((t (:background ,bg3))))
      (trailing-whitespace         ((t (:background ,bg-red))))
      (fill-column-indicator       ((t (:foreground ,bg3))))

      ;; Mode line, see bk-modeline.el
      (mode-line                   ((t (:background ,bg3 :foreground ,fg :box nil))))
      (mode-line-inactive          ((t (:background ,bg1 :foreground ,grey0 :box nil))))
      (mode-line-buffer-id         ((t (:foreground ,fg :weight bold))))
      (header-line                 ((t (:background ,bg2 :foreground ,fg))))

      ;; Syntax
      (font-lock-comment-face           ((t (:foreground ,grey1 :slant italic))))
      (font-lock-comment-delimiter-face ((t (:foreground ,grey1 :slant italic))))
      (font-lock-doc-face               ((t (:foreground ,grey2 :slant italic))))
      (font-lock-string-face            ((t (:foreground ,green))))
      (font-lock-keyword-face           ((t (:foreground ,red))))
      (font-lock-builtin-face           ((t (:foreground ,purple))))
      (font-lock-function-name-face     ((t (:foreground ,green :weight bold))))
      (font-lock-function-call-face     ((t (:foreground ,green))))
      (font-lock-variable-name-face     ((t (:foreground ,blue))))
      (font-lock-variable-use-face      ((t (:foreground ,fg))))
      (font-lock-type-face              ((t (:foreground ,yellow))))
      (font-lock-constant-face          ((t (:foreground ,purple))))
      (font-lock-number-face            ((t (:foreground ,purple))))
      (font-lock-operator-face          ((t (:foreground ,orange))))
      (font-lock-property-name-face     ((t (:foreground ,blue))))
      (font-lock-property-use-face      ((t (:foreground ,blue))))
      (font-lock-punctuation-face       ((t (:foreground ,grey2))))
      (font-lock-bracket-face           ((t (:foreground ,grey2))))
      (font-lock-delimiter-face         ((t (:foreground ,grey2))))
      (font-lock-escape-face            ((t (:foreground ,orange))))
      (font-lock-regexp-face            ((t (:foreground ,aqua))))
      (font-lock-preprocessor-face      ((t (:foreground ,purple))))
      (font-lock-negation-char-face     ((t (:foreground ,red))))
      (font-lock-warning-face           ((t (:foreground ,orange :weight bold))))

      ;; Search
      (isearch                     ((t (:background ,green :foreground ,bg0 :weight bold))))
      (isearch-fail                ((t (:background ,bg-red :foreground ,red))))
      (lazy-highlight              ((t (:background ,bg-blue :foreground ,fg))))
      (match                       ((t (:background ,bg-green :foreground ,fg))))
      (query-replace               ((t (:background ,green :foreground ,bg0))))

      ;; Feedback
      (error                       ((t (:foreground ,red :weight bold))))
      (warning                     ((t (:foreground ,yellow :weight bold))))
      (success                     ((t (:foreground ,green :weight bold))))
      (link                        ((t (:foreground ,blue :underline t))))
      (link-visited                ((t (:foreground ,purple :underline t))))
      (button                      ((t (:foreground ,blue :underline t))))
      (show-paren-match            ((t (:background ,bg4 :foreground ,orange :weight bold))))
      (show-paren-mismatch         ((t (:background ,red :foreground ,bg0 :weight bold))))

      ;; Completion
      (completions-common-part     ((t (:foreground ,green :weight bold))))
      (completions-first-difference ((t (:foreground ,orange))))
      (completions-annotations     ((t (:foreground ,grey1 :slant italic))))
      (completion-preview          ((t (:foreground ,grey0))))
      (completion-preview-common   ((t (:foreground ,grey1))))

      ;; which-key, built in since Emacs 30
      (which-key-key-face                   ((t (:foreground ,green :weight bold))))
      (which-key-command-description-face   ((t (:foreground ,fg))))
      (which-key-group-description-face     ((t (:foreground ,purple))))
      (which-key-separator-face             ((t (:foreground ,grey0))))

      ;; Dired, the netrw and oil.nvim replacement
      (dired-directory             ((t (:foreground ,green :weight bold))))
      (dired-header                ((t (:foreground ,blue :weight bold))))
      (dired-symlink               ((t (:foreground ,aqua))))
      (dired-broken-symlink        ((t (:background ,bg-red :foreground ,red))))
      (dired-marked                ((t (:foreground ,orange :weight bold))))
      (dired-flagged               ((t (:foreground ,red :weight bold))))
      (dired-perm-write            ((t (:foreground ,yellow))))
      (dired-ignored               ((t (:foreground ,grey0))))

      ;; Flymake, the ALE replacement
      (flymake-error               ((t (:underline (:style wave :color ,red)))))
      (flymake-warning             ((t (:underline (:style wave :color ,yellow)))))
      (flymake-note                ((t (:underline (:style wave :color ,aqua)))))
      (flymake-error-echo          ((t (:foreground ,red))))
      (flymake-warning-echo        ((t (:foreground ,yellow))))
      (flymake-note-echo           ((t (:foreground ,aqua))))

      ;; Eglot, the vim-lsp replacement
      (eglot-highlight-symbol-face ((t (:background ,bg3 :weight bold))))
      (eglot-mode-line             ((t (:foreground ,green :weight bold))))
      (eldoc-highlight-function-argument ((t (:foreground ,orange :weight bold))))

      ;; Diffs and version control
      (diff-added                  ((t (:background ,bg-green :foreground ,green :extend t))))
      (diff-removed                ((t (:background ,bg-red :foreground ,red :extend t))))
      (diff-changed                ((t (:background ,bg-blue :foreground ,blue :extend t))))
      (diff-header                 ((t (:foreground ,grey2 :weight bold))))
      (diff-file-header            ((t (:foreground ,blue :weight bold))))
      (diff-hunk-header            ((t (:background ,bg2 :foreground ,purple))))
      (diff-refine-added           ((t (:background ,bg-green :foreground ,green :weight bold))))
      (diff-refine-removed         ((t (:background ,bg-red :foreground ,red :weight bold))))
      (vc-edited-state             ((t (:foreground ,yellow))))
      (vc-locally-added-state      ((t (:foreground ,green))))
      (vc-conflict-state           ((t (:foreground ,red))))

      ;; Org, mostly for notes
      (org-level-1                 ((t (:foreground ,green :weight bold :height 1.15))))
      (org-level-2                 ((t (:foreground ,blue :weight bold :height 1.1))))
      (org-level-3                 ((t (:foreground ,purple :weight bold))))
      (org-level-4                 ((t (:foreground ,yellow :weight bold))))
      (org-block                   ((t (:background ,bg1 :extend t))))
      (org-block-begin-line        ((t (:background ,bg1 :foreground ,grey0 :extend t))))
      (org-code                    ((t (:foreground ,aqua))))
      (org-verbatim                ((t (:foreground ,green))))
      (org-table                   ((t (:foreground ,blue))))
      (org-todo                    ((t (:foreground ,red :weight bold))))
      (org-done                    ((t (:foreground ,green :weight bold))))
      (org-document-title          ((t (:foreground ,green :weight bold :height 1.2))))

      ;; Tabs
      (tab-bar                     ((t (:background ,bg-dim :foreground ,grey1))))
      (tab-bar-tab                 ((t (:background ,bg0 :foreground ,green :weight bold))))
      (tab-bar-tab-inactive        ((t (:background ,bg-dim :foreground ,grey0))))

      ;; Custom faces used by bk-modeline.el and bk-todo.el.  The state and
      ;; segment faces carry backgrounds because the mode line draws powerline
      ;; separators between them, and bk-modeline--sep reads these backgrounds to
      ;; colour the joins.
      (bk-modeline-normal-state    ((t (:background ,green :foreground ,bg0 :weight bold))))
      (bk-modeline-insert-state    ((t (:background ,blue :foreground ,bg0 :weight bold))))
      (bk-modeline-visual-state    ((t (:background ,purple :foreground ,bg0 :weight bold))))
      (bk-modeline-replace-state   ((t (:background ,orange :foreground ,bg0 :weight bold))))
      (bk-modeline-other-state     ((t (:background ,grey2 :foreground ,bg0 :weight bold))))
      (bk-modeline-recording       ((t (:foreground ,red :weight bold))))
      (bk-modeline-branch          ((t (:background ,bg4 :foreground ,aqua))))
      (bk-modeline-segment         ((t (:background ,bg4 :foreground ,fg))))
      (bk-review-added             ((t (:background ,bg-green :extend t))))
      (bk-todo-note                ((t (:background ,bg-blue :foreground ,blue :weight bold))))
      (bk-todo-todo                ((t (:background ,bg-yellow :foreground ,yellow :weight bold))))
      (bk-todo-warn                ((t (:background ,bg-red :foreground ,orange :weight bold))))
      (bk-todo-error               ((t (:background ,bg-red :foreground ,red :weight bold)))))))

(provide 'everforest-palette)
;;; everforest-palette.el ends here
